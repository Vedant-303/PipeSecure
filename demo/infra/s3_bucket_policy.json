{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadForPipelineOutput",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::acme-pipeline-output/*"
    },
    {
      "Sid": "ETLWriteAccess",
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::acme-pipeline-staging/*"
    }
  ]
}
